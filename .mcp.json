{
  "mcpServers": {
    "comet-kvm": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--python",
        "3.13",
        "python",
        "./glkvm_mcp.py"
      ],
      "env": {
        "VLM_PROVIDER": "openrouter",
        "VLM_MODEL": "openrouter/free"
      }
    }
  }
}
